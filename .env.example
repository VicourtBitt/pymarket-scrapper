# Copy this file to .env for local development.
# Explicit shell environment variables take precedence over these values.

# docker-compose: administrative superuser (initialization only)
DB_USER=postgres_admin
DB_PASS=change-me-admin
DB_NAME=pymarket
# docker-compose: application role created by db_init/ on first start
APP_DB_USER=pymarket_scrapper
APP_DB_PASS=change-me-app

# The application and Alembic connect as the application role.
DATABASE_URL=postgresql://pymarket_scrapper:change-me-app@localhost:5432/pymarket
MARKETPLACE=amazon
MARKETPLACE_CONFIG_DIR=configs
LOG_DIRECTORY=logs
PRODUCT_TITLE_CONTAINS=Semente
HEADLESS=false
